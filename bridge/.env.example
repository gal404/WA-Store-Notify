# העתק ל-.env ומלא. הקובץ הזה לא נכנס לגיט.

# כתובת אתר הוורדפרס (בלי / בסוף)
WP_URL=https://your-store.example.com

# המפתח מעמוד ההגדרות בתוסף (מוצג פעם אחת בלבד)
API_KEY=wsn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# הפורט של דף הסטטוס המקומי (127.0.0.1 בלבד)
PORT=3200

# תדירות משיכת הודעות (מילישניות)
POLL_MS=30000

# מזהה worker (חופשי — מופיע בלוגים בצד השרת)
WORKER_ID=pc-home
